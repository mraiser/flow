# Type stubs for ndata_py, the module the flowlang embedded Python runtime
# provides. flowb writes this file next to generated Python commands so
# editors and type checkers (pyright, mypy) can resolve it. The objects are
# handles on ndata's shared store: mutating one is visible to Rust and to
# every other holder.
from collections.abc import Iterable, Iterator, ItemsView, KeysView, Mapping, MutableMapping, MutableSequence, ValuesView
from typing import Any, overload

class NDataPyError(Exception): ...

def init() -> None: ...
def gc() -> None: ...
def to_py(x: Any) -> Any:
    """A deep native copy (dict, list, bytes, scalars) of ndata values, and of
    dicts, lists and tuples containing them. json.dumps(x, default=to_py)."""

class NDataObject(MutableMapping[str, Any]):
    """A dict-like handle on an ndata object. Registered as a MutableMapping."""
    def __init__(self) -> None: ...
    @staticmethod
    def from_json(json_string: str) -> NDataObject: ...
    def to_json(self) -> str: ...
    def shallow_copy(self) -> NDataObject: ...
    def deep_copy(self) -> NDataObject: ...
    def copy(self) -> NDataObject: ...
    def to_dict(self) -> dict[str, Any]: ...
    # typed accessors: raise KeyError / TypeError
    def get_string(self, key: str) -> str: ...
    def get_int(self, key: str) -> int: ...
    def get_float(self, key: str) -> float: ...
    def get_boolean(self, key: str) -> bool: ...
    def get_object(self, key: str) -> NDataObject: ...
    def get_array(self, key: str) -> NDataArray: ...
    def get_bytes(self, key: str) -> NDataBytes: ...
    def put_string(self, key: str, value: str) -> None: ...
    def put_int(self, key: str, value: int) -> None: ...
    def put_float(self, key: str, value: float) -> None: ...
    def put_boolean(self, key: str, value: bool) -> None: ...
    def put_object(self, key: str, obj: NDataObject) -> None: ...
    def put_array(self, key: str, arr: NDataArray) -> None: ...
    def put_bytes(self, key: str, bytes: NDataBytes) -> None: ...
    def put_null(self, key: str) -> None: ...
    # the dict protocol
    def __len__(self) -> int: ...
    def __contains__(self, key: object) -> bool: ...
    def __getitem__(self, key: str) -> Any: ...
    def __setitem__(self, key: str, value: Any) -> None: ...
    def __delitem__(self, key: str) -> None: ...
    def __iter__(self) -> Iterator[str]: ...
    def keys(self) -> KeysView[str]: ...
    def values(self) -> ValuesView[Any]: ...
    def items(self) -> ItemsView[str, Any]: ...
    # get, pop, popitem, setdefault and update have MutableMapping's signatures
    def popitem(self) -> tuple[str, Any]: ...
    def clear(self) -> None: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    __hash__: None  # type: ignore[assignment]

class NDataArray(MutableSequence[Any]):
    """A list-like handle on an ndata array. Registered as a MutableSequence."""
    def __init__(self) -> None: ...
    @staticmethod
    def from_json(json_string: str) -> NDataArray: ...
    def to_json(self) -> str: ...
    def shallow_copy(self) -> NDataArray: ...
    def deep_copy(self) -> NDataArray: ...
    def copy(self) -> NDataArray: ...
    def to_list(self) -> list[Any]: ...
    def __len__(self) -> int: ...
    def __contains__(self, x: object) -> bool: ...
    def __iter__(self) -> Iterator[Any]: ...
    def __reversed__(self) -> Iterator[Any]: ...
    @overload
    def __getitem__(self, index: int) -> Any: ...
    @overload
    def __getitem__(self, index: slice) -> NDataArray: ...
    # slice assignment and deletion are not supported
    def __setitem__(self, index: int, value: Any) -> None: ...  # type: ignore[override]
    def __delitem__(self, index: int) -> None: ...  # type: ignore[override]
    def append(self, value: Any) -> None: ...
    def extend(self, values: Iterable[Any]) -> None: ...
    def insert(self, index: int, value: Any) -> None: ...
    def pop(self, index: int = -1) -> Any: ...
    def remove(self, value: Any) -> None: ...
    def index(self, value: Any, start: int = 0, stop: int | None = None) -> int: ...
    def count(self, value: Any) -> int: ...
    def reverse(self) -> None: ...
    def clear(self) -> None: ...
    def __iadd__(self, values: Iterable[Any]) -> NDataArray: ...  # type: ignore[override,misc]
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    __hash__: None  # type: ignore[assignment]

class NDataBytes:
    """A handle on ndata bytes, also usable as a stream."""
    def __init__(self) -> None: ...
    @staticmethod
    def from_bytes(data: bytes) -> NDataBytes: ...
    def get_data(self) -> bytes: ...
    def set_data(self, data: bytes) -> None: ...
    def write(self, data: bytes) -> None: ...
    def read(self, n: int) -> bytes: ...
    def current_len(self) -> int: ...
    def stream_len(self) -> int: ...
    def set_stream_len(self, len: int) -> None: ...
    def is_write_open(self) -> bool: ...
    def is_read_open(self) -> bool: ...
    def close_write(self) -> None: ...
    def close_read(self) -> None: ...
    def get_mime_type(self) -> str | None: ...
    def set_mime_type(self, mime_type: str | None) -> None: ...
    def to_hex_string(self) -> str: ...
    def deep_copy(self) -> NDataBytes: ...
    def __len__(self) -> int: ...
    def __bytes__(self) -> bytes: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    __hash__: None  # type: ignore[assignment]
